# Copy to .env for local runs. Real values never go in git.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/aviary_bot_dev
GERTRUDE_URL=http://127.0.0.1:4010
# Bearer the bot presents to Gertrude's verify endpoint (BOT_TO_GERTRUDE_TOKEN).
GERTRUDE_VERIFY_TOKEN=
# Bearer Gertrude presents to POST /v1/send (GERTRUDE_TO_BOT_TOKEN). Must differ from the one above.
SEND_SERVICE_TOKEN=
# Teams bot registration (Entra app).
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
PORT=3978
# Optional: extra Bot Framework service URL hosts to trust (comma separated). Default: smba.trafficmanager.net
# SERVICE_URL_ALLOWED_HOSTS=
